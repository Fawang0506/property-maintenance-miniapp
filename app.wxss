page {
  background: #f5f7fa;
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei";
}

.button-primary {
  background: #1aad19;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 20rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.input-wrap {
  margin-top: 16rpx;
}

.input-wrap input,
.input-wrap textarea,
.input-wrap picker {
  background: #f5f7fa;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
}

.empty-state {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
