.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.content {
  color: #444;
  line-height: 1.8;
  font-size: 28rpx;
  white-space: pre-line;
}

.button-primary {
  background: #1aad19;
  color: #fff;
  border-radius: 10rpx;
}
