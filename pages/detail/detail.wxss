.page {
  padding-bottom: 40rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.meta {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.picker {
  background: #f5f7fa;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}

.button-primary {
  background: #1aad19;
  color: #fff;
  border-radius: 10rpx;
}
