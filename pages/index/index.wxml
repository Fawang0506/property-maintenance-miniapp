<view class="page">
  <view class="card">
    <button class="button-primary" bindtap="onCreate">新增报修</button>
  </view>

  <block wx:if="{{list.length > 0}}">
    <block wx:for="{{list}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="openDetail">
        <view style="display:flex;justify-content:space-between;align-items:center;">
          <text style="font-size:32rpx;font-weight:600;">{{item.title}}</text>
          <text wx:if="{{item.status}}" style="font-size:24rpx;color:#666;">{{item.status}}</text>
        </view>

        <view style="margin-top:16rpx;color:#666;">
          <view>类别：{{item.category || '一般维修'}}</view>
          <view>位置：{{item.location || '未填写'}}</view>
          <view>时间：{{item.createdAt || '未填写'}}</view>
        </view>
      </view>
    </block>
  </block>

  <view wx:else class="card empty-state">
    <text>暂无报修记录</text>
  </view>
</view>
