/* styles reuse */
.page {
  padding: 20rpx 20rpx 60rpx;
  background: #f5f7fa;
}

.header { margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 700; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.job-title { font-size: 32rpx; font-weight: 600; }
.meta { margin-top: 16rpx; color: #555; line-height: 1.8; }
.badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.badge.pending { background: #fff6cc; color: #8a5b00; }
.badge.processing { background: #e6f3ff; color: #1765c1; }
.badge.done { background: #eaf9ee; color: #198754; }

.actions { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap:wrap; }
.btn {
  min-width: 120rpx;
  height: 72rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 72rpx;
  text-align: center;
}
.btn.primary { background: #1aad19; }
.btn.warn { background: #f59e0b; }
.btn.success { background: #0f9d58; }
.btn.photo { background: #5b8def; }

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
