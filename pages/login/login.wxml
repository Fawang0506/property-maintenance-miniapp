<view class="page">
  <view class="card">
    <view class="section-title">登录 / 绑定</view>
    <view style="margin-top:18rpx;">
      <button class="button-primary" bindtap="onLogin">一键登录（获取身份）</button>
    </view>
    <view style="margin-top:18rpx;color:#666;">
      <text wx:if="{{user}}">已登录：{{user.nickName || user.openId}}</text>
      <text wx:else>未登录</text>
    </view>
  </view>
</view>
